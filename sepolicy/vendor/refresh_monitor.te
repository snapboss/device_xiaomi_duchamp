# Domain for refresh rate monitoring scripts
type refresh_bin_settings, exec_type, file_type;
type refresh_bin_awk, exec_type, file_type;

type refresh_monitor, domain;
type refresh_monitor_exec, exec_type, vendor_file_type, file_type;

allow init refresh_monitor:process transition;
allow init refresh_bin_settings:file { getattr open read execute };
allow refresh_monitor refresh_bin_settings:file { getattr execute read open execute_no_trans };
allow refresh_monitor refresh_bin_awk:file { getattr execute read open execute_no_trans };
allow refresh_monitor shell_exec:file { read open execute execute_no_trans };

